{
  "name": "mailcontrol",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/server/main.js",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "format:check": "prettier --check web server shared tests *.json *.ts *.md compose.yaml",
    "check:compose": "bash scripts/check-compose.sh",
    "package": "python3 scripts/package.py"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "@fontsource-variable/inter": "5.3.0",
    "fastify": "5.12.5",
    "lucide-react": "1.47.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.2.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
